{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlixNest",
  "version": "0.1.0",
  "identifier": "com.thsandorh.flixnest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlixNest",
        "width": 1560,
        "height": 980,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Cross-platform legal media center",
    "longDescription": "FlixNest is a modern Tauri-powered media center focused on elegant playback, provider management, profiles and offline flows for authorized media libraries.",
    "category": "Entertainment",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
